rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/staff/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/staff/$(request.auth.uid)).data.role == 'admin';
    }
    function isStaff() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/staff/$(request.auth.uid));
    }
    function staffRole() {
      return firestore.get(/databases/(default)/documents/staff/$(request.auth.uid)).data.role;
    }
    function isProductEditor() {
      return isStaff() && (staffRole() == 'admin' || staffRole() == 'zone_manager');
    }
    function isImageUnder5Mb() {
      return request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /staff/{staffId}/{fileName=**} {
      // MT Studio audit fix: আগে যেকোনো লগইন করা গ্রাহকও staff-দের ছবি/ফাইল দেখতে
      // পারত (isSignedIn())। এখন শুধু staff/admin।
      allow read: if isStaff();
      allow write: if isAdmin() && isImageUnder5Mb();
    }

    match /products/{fileName=**} {
      allow read: if true;
      allow write: if isProductEditor() && isImageUnder5Mb();
    }

    match /staff-chat/{fileName=**} {
      allow read: if isStaff();
      allow write: if isStaff() && isImageUnder5Mb();
    }

    match /review_photos/{fileName=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImageUnder5Mb();
    }

    match /prescriptions/{fileName=**} {
      // MT Studio audit fix: prescription ছবিতে গ্রাহকের মেডিকেল তথ্য (PII) থাকে —
      // আগে যেকোনো staff role (procurement/marketing/CRM ইত্যাদি) সবার প্রেসক্রিপশন
      // দেখতে পারত। এখন শুধু admin — এই মুহূর্তে অ্যাপে prescription যাচাইয়ের জন্য
      // নির্দিষ্ট কোনো staff role নেই বলে সবচেয়ে সীমিত অ্যাক্সেস রাখা হলো।
      allow read: if isAdmin();
      allow write: if isSignedIn() && isImageUnder5Mb();
    }

    match /{allPaths=**} {
      // MT Studio audit fix: আগে catch-all path-এও পাবলিক read allow ছিল (allow read: if true)
      // — উপরে ঘোষিত না-থাকা যেকোনো ভবিষ্যৎ storage path ডিফল্টভাবে উন্মুক্ত হয়ে যেত।
      // এখন default-deny — নতুন যেকোনো path-এর জন্য স্পষ্টভাবে rule যোগ করতে হবে।
      allow read: if false;
      allow write: if false;
    }
  }
}
