rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isStaff() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }
    function staffRole() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isStaff() && staffRole() == 'admin';
    }
    function isZoneManager() {
      return isStaff() && staffRole() == 'zone_manager';
    }
    function isDriver() {
      return isStaff() && staffRole() == 'driver';
    }
    function ownDriverId() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.driverId;
    }
    function isOwnDriverProfile(driverId) {
      return isDriver() && ownDriverId() == driverId;
    }
    function isInventoryManager() {
      return isStaff() && staffRole() == 'inventory_manager';
    }
    function isProcurementStaff() {
      return isStaff() && (staffRole() == 'procurement' || staffRole() == 'procurement_officer' || staffRole() == 'chief_procurement_officer' || staffRole() == 'vendor_relationship_officer' || staffRole() == 'procurement_vendor_manager' || staffRole() == 'warehouse_manager');
    }
    function isFinance() {
      return isStaff() && (staffRole() == 'finance' || staffRole() == 'financial_controller');
    }
    function isSupport() {
      return isStaff() && staffRole() == 'support';
    }
    function isCrmSupportStaff() {
      return isStaff() && (staffRole() == 'support' || staffRole() == 'support_manager' || staffRole() == 'crm_manager' || staffRole() == 'customer_experience_manager' || staffRole() == 'customer_care_manager');
    }
    function isProductEditor() {
      return isStaff() && (staffRole() == 'admin' || staffRole() == 'zone_manager');
    }
    function isAdminOrZoneManager() {
      return isProductEditor();
    }
    function isMarketingStaff() {
      return isStaff() && (staffRole() == 'marketing' || staffRole() == 'crm_manager' || staffRole() == 'growth_automation_manager');
    }
    // NEW — MT Studio security audit (2026-08): HR-এর নিজস্ব কোনো role-check
    // function আগে ছিল না, ফলে নিচের ~৭টা HR ERP collection-এ isStaff()
    // (যেকোনো staff — driver/marketing/support সহ) ব্লেন্কেট অ্যাক্সেস পেত।
    function isHR() {
      return isStaff() && (staffRole() == 'hr' || staffRole() == 'people_officer' || staffRole() == 'talent_development_manager');
    }
    function isOrderOwnerOrGuest() {
      return resource.data.userId == null ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ─── Users ───
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      // ⚠️ MT Studio security audit (2026-08) fix: আগে এখানে "isStaff() ||"
      // ছিল — অর্থাৎ যেকোনো staff role (driver, marketing, support, যে-কেউ)
      // যেকোনো কাস্টমারের walletBalance (আসল টাকা) এবং name/phone/address-এর
      // মতো PII কোনো field-restriction ছাড়াই বদলাতে পারতো। এখন:
      //  - wallet বাড়ানো/কমানো (bonus/refund/adjustment) শুধু admin/finance।
      //  - CRM/support staff শুধু কনট্যাক্ট/ঠিকানা ফিল্ড এডিট করতে পারবে,
      //    walletBalance স্পর্শ করতে পারবে না।
      //  - কাস্টমার নিজে আগের মতোই শুধু wallet কমাতে পারবে (checkout স্বনির্ভর
      //    transaction-এর জন্য দরকার)।
      allow update: if (isAdmin() || isFinance()) ||
        (
          isCrmSupportStaff() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name','phone','address','village','branchZone','district','updatedAt']) &&
          request.resource.data.walletBalance == resource.data.walletBalance
        ) ||
        (request.auth != null && request.auth.uid == userId &&
          request.resource.data.walletBalance <= resource.data.walletBalance &&
          request.resource.data.walletBalance >= 0 &&
          request.resource.data.referralBonusGiven == resource.data.referralBonusGiven &&
          request.resource.data.referralCode == resource.data.referralCode &&
          request.resource.data.referredBy == resource.data.referredBy &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['walletBalance']));
      allow delete: if false;
    }

    // ─── Staff ───
    match /staff/{staffId} {
      allow read: if request.auth != null &&
        (
          request.auth.uid == staffId ||
          isAdmin() || isFinance() ||
          (isStaff() && staffRole() in ['branch_manager','zone_manager','hr','people_officer','talent_development_manager'])
        );
      // ⚠️ MT Studio security audit (2026-08) fix: নন-admin HR/branch role
      // (branch_manager/zone_manager/hr/people_officer/talent_development_manager)
      // আগে নিজের নিজের staffId টার্গেট করেও baseSalary বদলাতে পারতো (কোনো
      // self-target-নিষেধ ছিল না) — অর্থাৎ একজন zone_manager নিজেই নিজের বেতন
      // বাড়িয়ে দিতে পারতো, যেটা সরাসরি payroll.js-এ ব্যবহার হয়। এখন এই non-admin
      // role-দের জন্য নিজের ডকুমেন্ট টার্গেট করা (self-edit) নিষিদ্ধ।
      allow write: if isAdmin() ||
        (
          isStaff() &&
          request.auth.uid != staffId &&
          staffRole() in ['branch_manager','zone_manager','hr','people_officer','talent_development_manager'] &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'branchId','branchCode','branchName',
            'probationReviewed','probationDecision','status',
            'designation','department','baseSalary','updatedAt'
          ])
        );
    }

    // ─── FCM Push Tokens ───
    match /fcmTokens/{userId} {
      // ⚠️ MT Studio security audit (2026-08) fix: আগে isStaff() (যেকোনো staff
      // role) সব কাস্টমার/staff-এর push token পড়তে পারতো — শুধু admin দরকার।
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ─── Products ───
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdminOrZoneManager();
      allow update: if isAdminOrZoneManager()
                    || (
                      isInventoryManager() &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['stock','status','updatedAt'])
                    )
                    || (
                      isProcurementStaff() &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['stock','status','updatedAt'])
                    )
                    || (
                      isSignedIn()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock','sold'])
                      && resource.data.stock is number
                      && resource.data.sold is number
                      && request.resource.data.stock is number
                      && request.resource.data.sold is number
                      && request.resource.data.stock >= 0
                      && request.resource.data.stock < resource.data.stock
                      && request.resource.data.sold > resource.data.sold
                      && (resource.data.stock - request.resource.data.stock)
                         == (request.resource.data.sold - resource.data.sold)
                      && (resource.data.stock - request.resource.data.stock) >= 1
                      && (resource.data.stock - request.resource.data.stock) <= 50
                    );
    }

    match /orders/{orderId} {
      // ⚠️ MT Studio security audit (2026-08) fix: আগে isDriver()-এর কোনো
      // scoping ছিল না — যেকোনো ড্রাইভার DevTools থেকে সরাসরি Firestore SDK
      // কল করে পুরো orders collection (সব কাস্টমারের নাম/ফোন/ঠিকানা, সব
      // ড্রাইভারের earning) পড়ে ফেলতে পারতো। এখন নিজের assign করা অর্ডারেই
      // সীমাবদ্ধ — অ্যাপ UI আগে থেকেই এভাবে query করতো, শুধু rule-টা এখন সেটা
      // সার্ভার-সাইডেও নিশ্চিত করছে।
      allow read: if isAdmin() || isZoneManager() || isFinance() || isSupport()
                  || (isDriver() && resource.data.driverId == request.auth.uid)
                  || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if false;

      allow update: if isAdmin() || isZoneManager()
                    || (
                      isDriver() &&
                      resource.data.driverId == request.auth.uid &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'status','driverAccepted','acceptedAt','rejectedAt','driverId','driverName',
                        'pickedUpAt','startedDeliveryAt','deliveredAt',
                        'driverLat','driverLng','driverAccuracy','locationUpdatedAt','updatedAt'
                      ]) &&
                      (
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['driverId'])
                        || request.resource.data.driverId == null
                      ) &&
                      request.resource.data.status in ['assigned','confirmed','packed','picked_up','in_transit','delivered']
                    )
                    || (
                      isOrderOwnerOrGuest() &&
                      (
                        (
                          request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['paymentMethod','paymentStatus','paymentTrxId','paymentVerifiedAt'])
                          && request.resource.data.paymentMethod in ['bkash','nagad']
                          && request.resource.data.paymentStatus == 'paid_pending_verification'
                          && request.resource.data.paymentTrxId is string
                          && request.resource.data.paymentTrxId.size() >= 8
                          && request.resource.data.paymentTrxId.size() <= 64
                          && request.resource.data.paymentVerifiedAt == null
                        )
                        ||
                        (
                          request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['paymentMethod','paymentStatus'])
                          && resource.data.status in ['pending','confirmed','packed','assigned']
                          && request.resource.data.status == resource.data.status
                          && request.resource.data.paymentMethod == 'cod'
                          && request.resource.data.paymentStatus == 'cod'
                        )
                        ||
                        (
                          resource.data.status in ['pending','confirmed','packed','assigned']
                          && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['status','cancelledAt','paymentStatus'])
                          && request.resource.data.status == 'cancelled'
                          && request.resource.data.paymentStatus == 'cancelled'
                          && request.resource.data.cancelledAt != null
                        )
                        ||
                        (
                          resource.data.status in ['pending','confirmed','packed','assigned']
                          && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['village','address','instructions'])
                          && request.resource.data.address is string
                          && request.resource.data.address.size() >= 5
                          && request.resource.data.address.size() <= 500
                        )
                        ||
                        (
                          resource.data.status == 'delivered'
                          && resource.data.refundRequested != true
                          && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['refundRequested','refundReason','refundStatus','refundRequestedAt'])
                          && request.resource.data.refundRequested == true
                          && request.resource.data.refundStatus == 'pending'
                          && request.resource.data.refundReason is string
                          && request.resource.data.refundReason.size() >= 3
                          && request.resource.data.refundReason.size() <= 500
                        )
                      )
                    );

      allow delete: if isAdmin();

      match /messages/{messageId} {
        // ⚠️ MT Studio security audit (2026-08) fix: আগে isDriver()-এর কোনো
        // scoping ছিল না — যেকোনো ড্রাইভার অন্য অর্ডারের চ্যাট থ্রেড পড়তে/জাল
        // মেসেজ পাঠাতে পারতো। এখন শুধু নিজের assign করা অর্ডারের চ্যাটেই।
        allow read: if isAdmin() || isZoneManager()
                    || (isDriver() && get(/databases/$(database)/documents/orders/$(orderId)).data.driverId == request.auth.uid)
                    || (isSignedIn() && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid);
        allow create: if isAdmin() || isZoneManager()
                      || (isDriver() && get(/databases/$(database)/documents/orders/$(orderId)).data.driverId == request.auth.uid
                          && request.resource.data.senderId == request.auth.uid)
                      || (isSignedIn() && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid
                          && request.resource.data.senderId == request.auth.uid);
        allow update, delete: if isAdmin();
      }

      match /private/{docId} {
        allow read: if isAdmin() || isFinance();
        allow write: if false;
      }
    }

    // ─── Drivers ───
    match /drivers/{driverId} {
      // ⚠️ MT Studio security audit (2026-08) fix: আগে isStaff() (যেকোনো staff
      // role) সব ড্রাইভারের live lat/lng ট্র্যাক করতে পারতো। এখন admin/zone
      // manager অথবা নিজের প্রোফাইলেই সীমাবদ্ধ।
      allow read: if isAdmin() || isZoneManager() || isOwnDriverProfile(driverId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (
          isOwnDriverProfile(driverId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'online','lastSeen',
            'lat','lng','locationUpdatedAt',
            'preferences','updatedAt',
            'phone','vehicleType'
          ])
        );

      match /opportunityOptIns/{optInId} {
        allow read: if isAdmin() || isMarketingStaff() || isOwnDriverProfile(driverId);
        allow create: if isStaff() && request.auth.uid != null
                      && request.resource.data.driverUid == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    match /driverOpportunities/{oppId} {
      allow read: if isStaff();
      allow write: if isAdmin() || isMarketingStaff();
    }

    // ─── Driver Payout Requests (cash-out) ───
    match /payoutRequests/{reqId} {
      allow read: if isAdmin() || isFinance() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow create: if false;
      allow update: if isAdmin() || isFinance();
      allow delete: if isAdmin();
    }

    // ─── Coupons ───
    match /coupons/{couponId} {
      // ⚠️ MT Studio security audit (2026-08) fix: আগে read:true পুরো coupon
      // ডকুমেন্ট (unpublished/inactive সহ) সবাইকে দেখাতো — marketing strategy
      // leak। এখন শুধু সক্রিয় কুপন public read করতে পারবে; পুরো তালিকা
      // (inactive সহ) শুধু admin/marketing দেখবে। createOrderSecure Cloud
      // Function-এ (Admin SDK) এই rule প্রযোজ্য না, তাই checkout অপ্রভাবিত।
      allow read: if resource.data.active == true || isAdmin() || isMarketingStaff();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']) &&
          resource.data.active == true &&
          request.resource.data.code == resource.data.code &&
          request.resource.data.type == resource.data.type &&
          request.resource.data.value == resource.data.value &&
          request.resource.data.active == resource.data.active &&
          request.resource.data.usedCount == resource.data.usedCount + 1 &&
          (!('usageLimit' in resource.data) ||
            resource.data.usageLimit == null ||
            resource.data.usageLimit == 0 ||
            request.resource.data.usedCount <= resource.data.usageLimit)
        );
    }

    match /saved_lists/{listId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ─── Reviews ───
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if
        (request.auth != null &&
         request.resource.data.orderId is string &&
         get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId == request.auth.uid &&
         get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status == 'delivered')
        &&
        // ⚠️ MT Studio security audit (2026-08) fix: আগে verified==false হলে
        // সম্পূর্ণ অ্যানোনিমাস (কোনো auth ছাড়াই) যেকোনো কনটেন্ট নিয়ে review
        // create করা যেত — photoUrl-এ HTML/JS payload বসিয়ে site-wide stored
        // XSS সম্ভব ছিল (services.js photoUrl escape করে না)। এখন signed-in +
        // সত্যিকারের delivered অর্ডারের মালিক হওয়া বাধ্যতামূলক, আর photoUrl
        // থাকলে অবশ্যই আমাদের নিজস্ব Firebase Storage থেকেই আসতে হবে।
        (
          !('photoUrl' in request.resource.data) ||
          request.resource.data.photoUrl == null ||
          (request.resource.data.photoUrl is string &&
           request.resource.data.photoUrl.matches('^https://firebasestorage\\.googleapis\\.com/.*'))
        );
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ─── SMS লগ ───
    match /sms_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }
    match /sms_failures/{failureId} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ─── Settings ───
    match /setting/app_version {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /setting/store {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /setting/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Inventory Manager: স্টক পরবর্তনের অডিট লগ ───
    match /stock_logs/{logId} {
      allow read: if isAdmin() || isFinance() || isInventoryManager() || isProcurementStaff();
      allow create: if isAdmin() || isZoneManager() || isInventoryManager();
      allow update, delete: if false;
    }

    // ─── রস্টক রিকোয়েস্ট ───
    match /restock_requests/{reqId} {
      allow read: if isAdmin() || isInventoryManager() || isProcurementStaff();
      allow create: if isInventoryManager();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── রিফান্ড রিকোয়েস্ট ───
    // ⚠️ MT Studio security audit (2026-08) fix: আগে isCrmSupportStaff() যে
    // request create করত, সেই একই role update (approve)-ও করতে পারতো —
    // অর্থাৎ একজন support agent নিজেই ভুয়া refund তৈরি করে নিজেই approve করে
    // দিতে পারতো (segregation-of-duties ভাঙা)। এখন approve/reject শুধু
    // admin/finance — request তৈরি support/CRM করবে কিন্তু নিজে চূড়ান্ত করতে
    // পারবে না।
    match /refund_requests/{reqId} {
      allow read: if isStaff();
      allow create: if isCrmSupportStaff() || isAdmin();
      allow update: if isFinance() || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── কাস্টমার সাপোর্ট টিকেট ───
    match /support_tickets/{ticketId} {
      allow read: if isStaff();
      allow create, update: if isCrmSupportStaff() || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── এস্কেলেশন ───
    match /escalations/{escId} {
      allow read: if isStaff();
      allow create: if isZoneManager() || isCrmSupportStaff() || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Staff Chat: Presence ───
    match /staff_presence/{uid} {
      allow read: if isStaff();
      allow write: if isStaff() && request.auth.uid == uid;
    }

    // ─── Staff Chat: কথোপকথন ───
    match /staff_conversations/{convId} {
      allow read: if isStaff() && request.auth.uid in resource.data.participants;
      allow create: if isStaff() && request.auth.uid in request.resource.data.participants;
      allow update: if isStaff() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isStaff() &&
          request.auth.uid in get(/databases/$(database)/documents/staff_conversations/$(convId)).data.participants;
        allow create: if isStaff() &&
          request.auth.uid in get(/databases/$(database)/documents/staff_conversations/$(convId)).data.participants &&
          request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // MT Studio security audit (2026-08): নিচের ~৪০টা ERP/HR/Finance-adjacent
    // collection-এ আগে শুধু bare isStaff() (যেকোনো staff role — driver,
    // marketing, support সহ) ছিল, কোনো role-scoping ছাড়াই। এতে যেকোনো
    // staff-এর employee salary slip/warning letter পড়া, নিজেকে loyalty
    // points দেওয়া, নিজের company asset assign+dispose+approve করা, নিজের
    // attendance জাল করে payroll বাড়ানো সম্ভব ছিল। এখন প্রতিটা collection তার
    // প্রকৃত দায়িত্বপ্রাপ্ত role-এ scope করা হয়েছে।
    // ═══════════════════════════════════════════════════════════════

    // ─── HR ERP ───
    match /job_requisitions/{id} { allow read, write: if isAdmin() || isHR(); }
    match /job_candidates/{id} { allow read, write: if isAdmin() || isHR(); }
    match /employee_onboarding/{id} { allow read, write: if isAdmin() || isHR(); }
    match /performance_reviews/{id} { allow read, write: if isAdmin() || isHR(); }
    match /training_programs/{id} { allow read: if isStaff(); allow write: if isAdmin() || isHR(); }
    match /employee_promotions/{id} { allow read, write: if isAdmin() || isHR(); }
    match /employee_documents/{id} { allow read, write: if isAdmin() || isHR(); }

    // ─── Attendance & Payroll ───
    // ⚠️ audit fix: attendance এখন self-scoped — নিজের চেক-ইন/আউট নিজেই,
    // অন্যের রেকর্ড শুধু admin/HR এডিট করতে পারবে (আগে payroll.js এই ডেটা
    // থেকেই overtime/deduction হিসাব করত, তাই forge করা মানে সরাসরি টাকা)।
    match /attendance_records/{id} {
      allow read: if isAdmin() || isFinance() || isHR() || (isStaff() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin() || isHR() || (isStaff() && request.resource.data.uid == request.auth.uid);
      allow update: if isAdmin() || isHR() || (isStaff() && resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid);
      allow delete: if isAdmin();
    }
    match /leave_requests/{id} {
      allow read: if isAdmin() || isHR() || (isStaff() && resource.data.uid == request.auth.uid);
      allow create: if isStaff() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || isHR();
      allow delete: if isAdmin();
    }
    match /company_holidays/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /payroll_records/{id} { allow read, write: if isAdmin() || isFinance(); }
    match /salary_adjustments/{id} { allow read, write: if isAdmin() || isFinance(); }

    // ─── Business Intelligence ───
    match /customer_profiles/{id} { allow read: if isStaff(); allow write: if isAdmin() || isCrmSupportStaff() || isMarketingStaff(); }
    match /business_kpis/{id} { allow read: if isStaff(); allow write: if isAdmin() || isFinance(); }
    match /expense_requests/{id} { allow read, write: if isAdmin() || isFinance(); }

    // ─── Asset Management ───
    match /company_assets/{id} { allow read: if isStaff(); allow write: if isAdmin() || isProcurementStaff(); }
    match /asset_assignments/{id} { allow read, write: if isStaff(); }
    match /asset_maintenance/{id} { allow read, write: if isStaff(); }
    match /asset_audits/{id} { allow read, write: if isAdmin() || isProcurementStaff(); }
    // ⚠️ audit fix: disposal তৈরি যে কেউ করতে পারবে (রিকোয়েস্ট), কিন্তু status
    // বদলানো (approve/complete) শুধু admin — আগে requester নিজেই নিজের
    // disposal approve করে ফেলতে পারতো (self-authorization)।
    match /asset_disposals/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isAdmin() || (isStaff() && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    // ─── Workflow Automation ───
    match /workflow_definitions/{id} { allow read, write: if isStaff(); }
    match /workflow_instances/{id} { allow read, write: if isStaff(); }
    // ⚠️ audit fix: approval নিজে-নিজে দেওয়া ঠেকাতে admin-only write।
    match /workflow_approvals/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /workflow_tasks/{id} { allow read, write: if isStaff(); }
    match /workflow_logs/{id} { allow read: if isStaff(); allow create: if isStaff(); allow update, delete: if false; }

    // ─── CRM (Office ও ERP উভয়ে ব্যবহৃত) ───
    // ⚠️ audit fix: customer_loyalty (redeemable points) আগে যেকোনো staff
    // লিখতে পারতো — নিজেকে/বন্ধুকে unlimited point দেওয়া সম্ভব ছিল।
    match /customer_loyalty/{id} { allow read: if isStaff(); allow write: if isAdmin() || isCrmSupportStaff() || isMarketingStaff(); }
    match /customer_wallets/{id} { allow read, write: if isAdmin() || isFinance(); }
    match /crm_campaigns/{id} { allow read: if isStaff(); allow write: if isAdmin() || isCrmSupportStaff() || isMarketingStaff(); }
    match /crm_activities/{id} { allow read: if isStaff(); allow write: if isAdmin() || isCrmSupportStaff() || isMarketingStaff(); }
    match /customer_interactions/{id} { allow read: if isStaff(); allow write: if isAdmin() || isCrmSupportStaff() || isMarketingStaff(); }
    match /support_knowledge_base/{id} { allow read: if isStaff(); allow write: if isAdmin() || isCrmSupportStaff(); }

    // ─── Finance ERP ───
    match /vendor_payments/{id} { allow read, write: if isAdmin() || isFinance(); }
    match /finance_accounts/{id} { allow read, write: if isAdmin() || isFinance(); }
    match /finance_journals/{id} { allow read, write: if isAdmin() || isFinance(); }
    match /department_budgets/{id} { allow read, write: if isAdmin() || isFinance(); }
    match /bank_reconciliation_items/{id} { allow read, write: if isAdmin() || isFinance(); }

    // ─── Facilities & Branch Operations ───
    match /branches/{id} { allow read: if true; allow write: if isAdmin() || isZoneManager() || (isStaff() && (staffRole() == 'branch_manager' || staffRole() == 'facilities_operations_manager')); }
    match /facility_requests/{id} { allow read, write: if isStaff(); }
    match /facility_rents/{id} { allow read, write: if isAdmin() || isFinance(); }
    match /facility_utilities/{id} { allow read, write: if isStaff(); }
    match /facility_inspections/{id} { allow read, write: if isStaff(); }
    match /facility_checklists/{id} { allow read, write: if isStaff(); }

    // ─── Procurement & Vendor ERP ───
    // ⚠️ audit fix: purchase_orders/goods_receipts/vendor_contracts আগে বেয়ার
    // isStaff()-এ ছিল — যেকোনো staff জাল গুডস-রিসিভ/ভেন্ডর-দায়বদ্ধতা রেকর্ড
    // বানাতে পারতো, vendor_invoices-এর মতোই role-scope করা হলো।
    match /vendors/{id} { allow read: if isStaff(); allow write: if isAdmin() || isProcurementStaff(); }
    match /suppliers/{id} { allow read: if isStaff(); allow write: if isAdmin() || isProcurementStaff(); }
    match /purchase_requests/{id} { allow read: if isStaff(); allow write: if isAdmin() || isProcurementStaff(); }
    match /vendor_quotations/{id} { allow read: if isStaff(); allow write: if isAdmin() || isProcurementStaff(); }
    match /purchase_orders/{id} { allow read, write: if isAdmin() || isFinance() || isProcurementStaff(); }
    match /goods_receipts/{id} { allow read, write: if isAdmin() || isFinance() || isProcurementStaff(); }
    match /vendor_invoices/{id} { allow read, write: if isAdmin() || isFinance() || isProcurementStaff(); }

    // ─── Warehouse ERP ───
    match /warehouse_locations/{id} { allow read: if isStaff(); allow write: if isAdmin() || isInventoryManager() || isProcurementStaff(); }
    match /warehouse_bin_inventory/{id} { allow read: if isStaff(); allow write: if isAdmin() || isInventoryManager() || isProcurementStaff(); }
    match /warehouse_transfers/{id} { allow read: if isStaff(); allow write: if isAdmin() || isInventoryManager() || isProcurementStaff(); }
    match /warehouse_cycle_counts/{id} { allow read: if isStaff(); allow write: if isAdmin() || isInventoryManager() || isProcurementStaff(); }
    match /warehouse_damage_records/{id} { allow read: if isStaff(); allow write: if isAdmin() || isInventoryManager() || isProcurementStaff(); }

    // ─── Company OS ───
    match /company_notices/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /company_notifications/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /company_os_activity/{id} { allow read, create: if isStaff(); allow update, delete: if false; }

    // ─── Company Settings (Access Control / Permission Matrix) ───
    match /company_settings/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ─── Settings audit log ───
    match /settings_audit_logs/{id} { allow read: if isAdmin(); allow create: if isStaff(); allow update, delete: if false; }

    // ─── Branch Office (audits/transfers) ───
    match /branch_audits/{id} { allow read: if isStaff(); allow write: if isAdmin() || isZoneManager() || (isStaff() && staffRole() == 'branch_manager'); }
    match /branch_transfers/{id} { allow read: if isStaff(); allow write: if isAdmin() || isZoneManager() || (isStaff() && staffRole() == 'branch_manager'); }

    // ─── BI snapshots ───
    match /business_intelligence_snapshots/{id} { allow read: if isStaff(); allow write: if isAdmin() || isFinance(); }

    // ─── Marketing ERP (campaigns/coupons/loyalty/automation) ───
    match /marketing_campaigns/{id} { allow read, write: if isAdmin() || isMarketingStaff(); }
    match /marketing_coupons/{id} { allow read, write: if isAdmin() || isMarketingStaff(); }
    match /loyalty_rules/{id} { allow read, write: if isAdmin() || isMarketingStaff(); }
    match /marketing_automations/{id} { allow read, write: if isAdmin() || isMarketingStaff(); }
    match /marketing_automation_runs/{id} { allow read, write: if isAdmin() || isMarketingStaff(); }
    match /customer_referrals/{id} { allow read, write: if isAdmin() || isMarketingStaff(); }

    // ─── Payroll runs ───
    match /payroll_runs/{id} { allow read, write: if isAdmin() || isFinance(); }

    // ─── Procurement (quotations/vendor contracts & documents) ───
    match /quotation_requests/{id} { allow read: if isStaff(); allow write: if isAdmin() || isProcurementStaff(); }
    match /quotation_responses/{id} { allow read: if isStaff(); allow write: if isAdmin() || isProcurementStaff(); }
    match /vendor_contracts/{id} { allow read, write: if isAdmin() || isFinance() || isProcurementStaff(); }
    match /vendor_documents/{id} { allow read, write: if isAdmin() || isFinance() || isProcurementStaff(); }

    // ─── AI Control Center (forecast/recommendation automations) ───
    match /ai_automations/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /ai_reports/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /ai_decision_logs/{id} { allow read: if isStaff(); allow write: if isAdmin(); }

    // ─── Customer saved addresses ───
    match /addresses/{id} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ─── Default: বাকি সবকিছু বন্ধ ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
