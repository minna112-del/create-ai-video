rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    // AUTH / STAFF HELPERS
    // ═══════════════════════════════════════════════════════════════

    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function staffData() {
      return get(
        /databases/$(database)/documents/staff/$(request.auth.uid)
      ).data;
    }

    function staffRole() {
      return staffData().role;
    }

    function staffZone() {
      return staffData().get(
        'branchZone',
        staffData().get('zoneId', null)
      );
    }

    function isAdmin() {
      return isStaff() &&
        staffRole() == 'admin';
    }

    function isZoneManager() {
      return isStaff() &&
        staffRole() == 'zone_manager';
    }

    function isDriver() {
      return isStaff() &&
        staffRole() == 'driver';
    }

    function isInventoryManager() {
      return isStaff() &&
        staffRole() == 'inventory_manager';
    }

    function isFinance() {
      return isStaff() &&
        staffRole() in [
          'finance',
          'financial_controller'
        ];
    }

    function isSupport() {
      return isStaff() &&
        staffRole() in [
          'support',
          'support_manager'
        ];
    }

    function isCrmSupportStaff() {
      return isStaff() &&
        staffRole() in [
          'support',
          'support_manager',
          'crm_manager',
          'customer_experience_manager',
          'customer_care_manager'
        ];
    }

    function isProcurementStaff() {
      return isStaff() &&
        staffRole() in [
          'procurement',
          'procurement_officer',
          'chief_procurement_officer',
          'vendor_relationship_officer',
          'procurement_vendor_manager',
          'warehouse_manager'
        ];
    }

    function isMarketingStaff() {
      return isStaff() &&
        staffRole() in [
          'marketing',
          'crm_manager',
          'growth_automation_manager'
        ];
    }

    function isHR() {
      return isStaff() &&
        staffRole() in [
          'hr',
          'people_officer',
          'talent_development_manager'
        ];
    }

    // audit fix: analytics_manager/business_intelligence_manager/ai_operations_manager
    // js/employee-management.js-এর role catalog-এ অফিসিয়াল পদ হিসেবে আছে (Analytics
    // Center/AI Control/BI Center-এর জন্য), কিন্তু rules-এ এই রোলগুলোর কোনো অস্তিত্বই
    // ছিল না — তাই এই পদে থাকা কেউ ড্যাশবোর্ড খুলতে পারলেও orders/drivers/
    // refund_requests ডেটা কখনো পড়তে পারতো না।
    function isAnalyticsStaff() {
      return isStaff() &&
        staffRole() in [
          'analytics_manager',
          'business_intelligence_manager',
          'ai_operations_manager'
        ];
    }

    function ownDriverId() {
      return staffData().get(
        'driverId',
        request.auth.uid
      );
    }

    function isOwnDriverProfile(driverId) {
      return isDriver() &&
        ownDriverId() == driverId;
    }

    function isProductEditor() {
      return isStaff() &&
        staffRole() in [
          'admin',
          'zone_manager'
        ];
    }

    function isAdminOrZoneManager() {
      return isProductEditor();
    }

    function orderZone() {
      return resource.data.get(
        'branchZone',
        resource.data.get('zoneId', null)
      );
    }

    function requestedOrderZone() {
      return request.resource.data.get(
        'branchZone',
        request.resource.data.get('zoneId', null)
      );
    }

    function isOwnZoneOrder() {
      return isZoneManager() &&
        staffZone() != null &&
        orderZone() == staffZone();
    }

    function isOwnZoneOrderCreate() {
      return isZoneManager() &&
        staffZone() != null &&
        requestedOrderZone() == staffZone();
    }

    function isOrderOwner() {
      return isSignedIn() &&
        resource.data.userId == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════════
    // USERS
    // ═══════════════════════════════════════════════════════════════

    match /users/{userId} {

      allow read: if isSignedIn() &&
        request.auth.uid == userId;

      /*
       * নতুন user profile ideally Cloud Function/Admin SDK দিয়ে create হবে।
       * যদি frontend এখনও self-create করে, wallet/referral-sensitive fields
       * client থেকে নির্ধারণ করা যাবে না।
       */
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.get('walletBalance', 0) == 0 &&
        request.resource.data.get('referralBonusGiven', false) == false;

      allow update: if

        // Admin / Finance
        isAdmin() ||
        isFinance() ||

        // CRM / Support: শুধু contact/address fields
        (
          isCrmSupportStaff() &&
          request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'name',
              'phone',
              'address',
              'village',
              'branchZone',
              'zoneId',
              'district',
              'updatedAt'
            ]) &&
          request.resource.data.get('walletBalance', 0) ==
            resource.data.get('walletBalance', 0)
        ) ||

        // Customer নিজের profile/contact update
        (
          isSignedIn() &&
          request.auth.uid == userId &&
          request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'name',
              'phone',
              'address',
              'village',
              'branchZone',
              'zoneId',
              'district',
              'photoURL',
              // audit fix: js/auth.js-এর AccountPage.saveAddress()/deleteAddress()
              // 'addresses' array field লেখে — এই ফিল্ড আগে অনুমোদিত তালিকায় ছিল না,
              // তাই সংরক্ষিত ঠিকানা ফিচার সবসময় permission-denied দিত।
              'addresses',
              'updatedAt'
            ]) &&
          request.resource.data.get('walletBalance', 0) ==
            resource.data.get('walletBalance', 0) &&
          request.resource.data.get(
            'referralBonusGiven',
            false
          ) ==
            resource.data.get(
              'referralBonusGiven',
              false
            ) &&
          request.resource.data.get(
            'referralCode',
            null
          ) ==
            resource.data.get(
              'referralCode',
              null
            ) &&
          request.resource.data.get(
            'referredBy',
            null
          ) ==
            resource.data.get(
              'referredBy',
              null
            )
        );

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // STAFF
    // ═══════════════════════════════════════════════════════════════

    match /staff/{staffId} {

      allow read: if isSignedIn() &&
        (
          request.auth.uid == staffId ||
          isAdmin() ||
          isFinance() ||
          isHR() ||
          isZoneManager()
        );

      /*
       * Role, salary, zone, driverId ইত্যাদি authoritative access data।
       * এগুলো শুধু Admin পরিবর্তন করবে।
       */
      allow create, update, delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // FCM PUSH TOKENS
    // ═══════════════════════════════════════════════════════════════

    match /fcmTokens/{userId} {

      allow read: if isAdmin() ||
        (
          isSignedIn() &&
          request.auth.uid == userId
        );

      allow create, update: if isSignedIn() &&
        request.auth.uid == userId;

      allow delete: if isSignedIn() &&
        request.auth.uid == userId;
    }

    // ═══════════════════════════════════════════════════════════════
    // PRODUCTS
    // ═══════════════════════════════════════════════════════════════

    match /products/{productId} {

      allow read: if true;

      allow create, delete: if
        isAdminOrZoneManager();

      allow update: if

        isAdminOrZoneManager() ||

        (
          isInventoryManager() &&
          request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'stock',
              'status',
              'updatedAt'
            ])
        ) ||

        (
          isProcurementStaff() &&
          request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'stock',
              'status',
              'updatedAt'
            ])
        );

      /*
       * Customer direct stock decrement intentionally removed.
       * Order creation + stock decrement Cloud Function transaction করবে।
       */
    }

    // ═══════════════════════════════════════════════════════════════
    // ORDERS
    // ═══════════════════════════════════════════════════════════════

    match /orders/{orderId} {

      allow read: if

        isAdmin() ||

        isOwnZoneOrder() ||

        isFinance() ||

        isSupport() ||

        isAnalyticsStaff() ||

        (
          isDriver() &&
          resource.data.driverId == ownDriverId()
        ) ||

        isOrderOwner();

      /*
       * Order creation secure Cloud Function দিয়ে হবে।
       */
      allow create: if false;

      /*
       * Sensitive order transition/payment/cancellation Cloud Function
       * দিয়ে হবে।
       *
       * Firestore client write শুধু:
       * - Admin
       * - নিজের Zone-এর Zone Manager
       * - Driver location / lightweight operational metadata
       */
      allow update: if

        isAdmin() ||

        isOwnZoneOrder() ||

        (
          isDriver() &&
          resource.data.driverId == ownDriverId() &&
          request.resource.data.driverId ==
            resource.data.driverId &&
          request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'driverLat',
              'driverLng',
              'driverAccuracy',
              'locationUpdatedAt',
              'updatedAt'
            ])
        ) ||

        // audit fix: কাস্টমার নিজের অর্ডার — শুধু driver pickup-এর আগে (js/auth.js-এর
        // OrderEdit.isEditable() একই status list চেক করে), শুধু ঠিকানা/নির্দেশনা।
        // এই clause না থাকায় "Edit Order" বাটন সবসময় permission-denied দিত।
        (
          isOrderOwner() &&
          resource.data.status in [
            'pending',
            'confirmed',
            'packed',
            'assigned'
          ] &&
          request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'village',
              'address',
              'instructions',
              'updatedAt'
            ])
        );

      allow delete: if isAdmin();

      // ─── ORDER CHAT ───

      match /messages/{messageId} {

        function parentOrder() {
          return get(
            /databases/$(database)/documents/orders/$(orderId)
          ).data;
        }

        function parentOrderZone() {
          return parentOrder().get(
            'branchZone',
            parentOrder().get('zoneId', null)
          );
        }

        function zoneManagerOwnsParentOrder() {
          return isZoneManager() &&
            staffZone() != null &&
            parentOrderZone() == staffZone();
        }

        allow read: if

          isAdmin() ||

          zoneManagerOwnsParentOrder() ||

          (
            isDriver() &&
            parentOrder().driverId ==
              ownDriverId()
          ) ||

          (
            isSignedIn() &&
            parentOrder().userId ==
              request.auth.uid
          );

        allow create: if

          isAdmin() ||

          zoneManagerOwnsParentOrder() ||

          (
            isDriver() &&
            parentOrder().driverId ==
              ownDriverId() &&
            request.resource.data.senderId ==
              request.auth.uid
          ) ||

          (
            isSignedIn() &&
            parentOrder().userId ==
              request.auth.uid &&
            request.resource.data.senderId ==
              request.auth.uid
          );

        allow update, delete: if isAdmin();
      }

      // ─── ORDER PRIVATE DATA ───

      match /private/{docId} {
        allow read: if isAdmin() || isFinance();
        allow write: if false;
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // DRIVERS
    // ═══════════════════════════════════════════════════════════════

    match /drivers/{driverId} {

      allow read: if
        isAdmin() ||
        isZoneManager() ||
        isAnalyticsStaff() ||
        isOwnDriverProfile(driverId);

      allow create, delete: if isAdmin();

      allow update: if

        isAdmin() ||

        (
          isOwnDriverProfile(driverId) &&
          request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'online',
              'lastSeen',
              'lat',
              'lng',
              'locationUpdatedAt',
              'preferences',
              'updatedAt',
              'phone',
              'vehicleType'
            ])
        );

      match /opportunityOptIns/{optInId} {

        allow read: if
          isAdmin() ||
          isMarketingStaff() ||
          isOwnDriverProfile(driverId);

        allow create: if
          isOwnDriverProfile(driverId) &&
          request.resource.data.driverUid ==
            request.auth.uid;

        allow update, delete: if isAdmin();
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // DRIVER OPPORTUNITIES
    // ═══════════════════════════════════════════════════════════════

    match /driverOpportunities/{oppId} {

      allow read: if isStaff();

      allow create, update, delete: if
        isAdmin() ||
        isMarketingStaff();
    }

    // ═══════════════════════════════════════════════════════════════
    // DRIVER PAYOUT REQUESTS
    // ═══════════════════════════════════════════════════════════════

    match /payoutRequests/{reqId} {

      allow read: if

        isAdmin() ||

        isFinance() ||

        (
          isDriver() &&
          resource.data.driverId ==
            ownDriverId()
        );

      /*
       * Cash-out request preferably Cloud Function দিয়ে create হবে।
       */
      allow create: if false;

      allow update: if
        isAdmin() ||
        isFinance();

      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // COUPONS
    // ═══════════════════════════════════════════════════════════════

    match /coupons/{couponId} {

      allow read: if
        resource.data.active == true ||
        isAdmin() ||
        isMarketingStaff();

      allow create, update, delete: if
        isAdmin() ||
        isMarketingStaff();

      /*
       * Customer-side usedCount increment removed.
       * Coupon usage Cloud Function transaction করবে।
       */
    }

    // ═══════════════════════════════════════════════════════════════
    // SAVED LISTS
    // ═══════════════════════════════════════════════════════════════

    match /saved_lists/{listId} {

      allow read, delete: if
        isSignedIn() &&
        resource.data.userId ==
          request.auth.uid;

      allow create: if
        isSignedIn() &&
        request.resource.data.userId ==
          request.auth.uid;

      allow update: if
        isSignedIn() &&
        resource.data.userId ==
          request.auth.uid &&
        request.resource.data.userId ==
          request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════════
    // REVIEWS
    // ═══════════════════════════════════════════════════════════════

    match /reviews/{reviewId} {

      allow read: if true;

      allow create: if

        isSignedIn() &&

        request.resource.data.orderId is string &&

        get(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data.userId ==
          request.auth.uid &&

        get(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data.status ==
          'delivered' &&

        (
          !(
            'photoUrl' in
            request.resource.data
          ) ||

          request.resource.data.photoUrl ==
            null ||

          (
            request.resource.data.photoUrl
              is string &&

            request.resource.data.photoUrl.matches(
              '^https://firebasestorage\\.googleapis\\.com/.*'
            )
          )
        );

      allow update: if false;

      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // SMS LOGS
    // ═══════════════════════════════════════════════════════════════

    match /sms_logs/{logId} {

      allow read: if isAdmin();

      allow create: if isStaff();

      allow update, delete: if false;
    }

    match /sms_failures/{failureId} {

      allow read: if isAdmin();

      allow create: if isStaff();

      allow update: if isAdmin();

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // SETTINGS
    // ═══════════════════════════════════════════════════════════════

    // Public app version
    match /setting/app_version {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public store configuration
    match /setting/store {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public delivery/service area configuration
    match /setting/delivery {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /setting/delivery_zones {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /setting/service_areas {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /setting/branches {
      allow read: if true;
      allow write: if isAdmin();
    }

    /*
     * Zone Manager PIN public-readable হবে না।
     */
    match /setting/zone_manager_pins {
      allow read, write: if isAdmin();
    }

    /*
     * Unknown settings public নয়।
     */
    match /setting/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // STOCK LOGS
    // ═══════════════════════════════════════════════════════════════

    match /stock_logs/{logId} {

      allow read: if
        isAdmin() ||
        isFinance() ||
        isInventoryManager() ||
        isProcurementStaff();

      allow create: if
        isAdmin() ||
        isZoneManager() ||
        isInventoryManager() ||
        isProcurementStaff();

      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // RESTOCK REQUESTS
    // ═══════════════════════════════════════════════════════════════

    match /restock_requests/{reqId} {

      allow read: if
        isAdmin() ||
        isInventoryManager() ||
        isProcurementStaff();

      allow create: if
        isInventoryManager() ||
        isProcurementStaff();

      allow update: if
        isAdmin() ||
        isProcurementStaff();

      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // REFUND REQUESTS
    // ═══════════════════════════════════════════════════════════════

    match /refund_requests/{reqId} {

      allow read: if
        isAdmin() ||
        isFinance() ||
        isCrmSupportStaff() ||
        isAnalyticsStaff();

      allow create: if
        isCrmSupportStaff() ||
        isAdmin();

      allow update: if
        isFinance() ||
        isAdmin();

      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // SUPPORT TICKETS
    // ═══════════════════════════════════════════════════════════════

    match /support_tickets/{ticketId} {

      allow read: if
        isAdmin() ||
        isCrmSupportStaff();

      allow create, update: if
        isCrmSupportStaff() ||
        isAdmin();

      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // ESCALATIONS
    // ═══════════════════════════════════════════════════════════════

    match /escalations/{escId} {

      allow read: if
        isAdmin() ||
        isZoneManager() ||
        isCrmSupportStaff();

      allow create: if
        isZoneManager() ||
        isCrmSupportStaff() ||
        isAdmin();

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // STAFF CHAT — PRESENCE
    // ═══════════════════════════════════════════════════════════════

    match /staff_presence/{uid} {

      allow read: if isStaff();

      allow create, update, delete: if
        isStaff() &&
        request.auth.uid == uid;
    }

    // ═══════════════════════════════════════════════════════════════
    // STAFF CHAT — CONVERSATIONS
    // ═══════════════════════════════════════════════════════════════

    match /staff_conversations/{convId} {

      allow read: if
        isStaff() &&
        request.auth.uid in
          resource.data.participants;

      allow create: if
        isStaff() &&
        request.auth.uid in
          request.resource.data.participants;

      allow update: if
        isStaff() &&
        request.auth.uid in
          resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {

        allow read: if

          isStaff() &&

          request.auth.uid in

            get(
              /databases/$(database)/documents/staff_conversations/$(convId)
            ).data.participants;

        allow create: if

          isStaff() &&

          request.auth.uid in

            get(
              /databases/$(database)/documents/staff_conversations/$(convId)
            ).data.participants &&

          request.resource.data.senderId ==
            request.auth.uid;

        allow update, delete: if false;
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // HR ERP
    // ═══════════════════════════════════════════════════════════════

    match /job_requisitions/{id} {
      allow read, write: if isAdmin() || isHR();
    }

    match /job_candidates/{id} {
      allow read, write: if isAdmin() || isHR();
    }

    match /employee_onboarding/{id} {
      allow read, write: if isAdmin() || isHR();
    }

    match /performance_reviews/{id} {
      allow read, write: if isAdmin() || isHR();
    }

    match /training_programs/{id} {
      allow read: if isStaff();
      allow write: if isAdmin() || isHR();
    }

    match /employee_promotions/{id} {
      allow read, write: if isAdmin() || isHR();
    }

    match /employee_documents/{id} {
      allow read, write: if isAdmin() || isHR();
    }

    // ═══════════════════════════════════════════════════════════════
    // ATTENDANCE & PAYROLL
    // ═══════════════════════════════════════════════════════════════

    match /attendance_records/{id} {

      allow read: if

        isAdmin() ||
        isFinance() ||
        isHR() ||

        (
          isStaff() &&
          resource.data.uid ==
            request.auth.uid
        );

      allow create: if

        isAdmin() ||
        isHR() ||

        (
          isStaff() &&
          request.resource.data.uid ==
            request.auth.uid
        );

      allow update: if

        isAdmin() ||
        isHR() ||

        (
          isStaff() &&
          resource.data.uid ==
            request.auth.uid &&
          request.resource.data.uid ==
            resource.data.uid
        );

      allow delete: if isAdmin();
    }

    match /leave_requests/{id} {

      allow read: if

        isAdmin() ||
        isHR() ||

        (
          isStaff() &&
          resource.data.uid ==
            request.auth.uid
        );

      allow create: if

        isStaff() &&
        request.resource.data.uid ==
          request.auth.uid;

      allow update: if
        isAdmin() ||
        isHR();

      allow delete: if isAdmin();
    }

    match /company_holidays/{id} {

      allow read: if isStaff();

      allow write: if isAdmin();
    }

    match /payroll_records/{id} {

      allow read, write: if
        isAdmin() ||
        isFinance();
    }

    match /salary_adjustments/{id} {

      allow read, write: if
        isAdmin() ||
        isFinance();
    }

    match /payroll_runs/{id} {

      allow read, write: if
        isAdmin() ||
        isFinance();
    }

    // ═══════════════════════════════════════════════════════════════
    // BUSINESS INTELLIGENCE
    // ═══════════════════════════════════════════════════════════════

    match /customer_profiles/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isCrmSupportStaff() ||
        isMarketingStaff();
    }

    match /business_kpis/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isFinance();
    }

    match /expense_requests/{id} {

      allow read: if
        isAdmin() ||
        isFinance() ||
        isAnalyticsStaff();

      allow write: if
        isAdmin() ||
        isFinance();
    }

    match /business_intelligence_snapshots/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isFinance();
    }

    // ═══════════════════════════════════════════════════════════════
    // ASSET MANAGEMENT
    // ═══════════════════════════════════════════════════════════════

    match /company_assets/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isProcurementStaff();
    }

    match /asset_assignments/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isProcurementStaff();
    }

    match /asset_maintenance/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isProcurementStaff();
    }

    match /asset_audits/{id} {

      allow read, write: if
        isAdmin() ||
        isProcurementStaff();
    }

    match /asset_disposals/{id} {

      allow read: if isStaff();

      allow create: if
        isStaff();

      allow update: if
        isAdmin() ||
        (
          isStaff() &&
          request.resource.data.status ==
            resource.data.status
        );

      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // WORKFLOW AUTOMATION
    // ═══════════════════════════════════════════════════════════════

    match /workflow_definitions/{id} {

      allow read: if isStaff();

      allow write: if isAdmin();
    }

    match /workflow_instances/{id} {

      allow read: if isStaff();

      allow create, update: if
        isAdmin() ||
        isZoneManager() ||
        isCrmSupportStaff() ||
        isInventoryManager();

      allow delete: if isAdmin();
    }

    match /workflow_approvals/{id} {

      allow read: if isStaff();

      allow write: if isAdmin();
    }

    match /workflow_tasks/{id} {

      allow read: if isStaff();

      allow create, update: if
        isAdmin() ||
        isZoneManager() ||
        isCrmSupportStaff() ||
        isInventoryManager();

      allow delete: if isAdmin();
    }

    match /workflow_logs/{id} {

      allow read: if isStaff();

      allow create: if isStaff();

      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // CRM
    // ═══════════════════════════════════════════════════════════════

    match /customer_loyalty/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isCrmSupportStaff() ||
        isMarketingStaff();
    }

    match /customer_wallets/{id} {

      allow read, write: if
        isAdmin() ||
        isFinance();
    }

    match /crm_campaigns/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isCrmSupportStaff() ||
        isMarketingStaff();
    }

    match /crm_activities/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isCrmSupportStaff() ||
        isMarketingStaff();
    }

    match /customer_interactions/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isCrmSupportStaff() ||
        isMarketingStaff();
    }

    match /support_knowledge_base/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isCrmSupportStaff();
    }

    // ═══════════════════════════════════════════════════════════════
    // FINANCE ERP
    // ═══════════════════════════════════════════════════════════════

    match /vendor_payments/{id} {
      allow read, write: if isAdmin() || isFinance();
    }

    match /finance_accounts/{id} {
      allow read, write: if isAdmin() || isFinance();
    }

    match /finance_journals/{id} {
      allow read, write: if isAdmin() || isFinance();
    }

    match /department_budgets/{id} {
      allow read, write: if isAdmin() || isFinance();
    }

    match /bank_reconciliation_items/{id} {
      allow read, write: if isAdmin() || isFinance();
    }

    // ═══════════════════════════════════════════════════════════════
    // FACILITIES / BRANCH OPERATIONS
    // ═══════════════════════════════════════════════════════════════

    match /branches/{id} {

      allow read: if true;

      allow write: if
        isAdmin() ||
        isZoneManager() ||
        (
          isStaff() &&
          staffRole() in [
            'branch_manager',
            'facilities_operations_manager'
          ]
        );
    }

    match /facility_requests/{id} {

      allow read: if isStaff();

      allow create: if isStaff();

      allow update: if
        isAdmin() ||
        isZoneManager();

      allow delete: if isAdmin();
    }

    match /facility_rents/{id} {

      allow read, write: if
        isAdmin() ||
        isFinance();
    }

    match /facility_utilities/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isZoneManager();
    }

    match /facility_inspections/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isZoneManager();
    }

    match /facility_checklists/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isZoneManager();
    }

    // ═══════════════════════════════════════════════════════════════
    // PROCUREMENT & VENDOR ERP
    // ═══════════════════════════════════════════════════════════════

    match /vendors/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isProcurementStaff();
    }

    match /suppliers/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isProcurementStaff();
    }

    match /purchase_requests/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isProcurementStaff();
    }

    match /vendor_quotations/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isProcurementStaff();
    }

    match /purchase_orders/{id} {

      allow read: if
        isAdmin() ||
        isFinance() ||
        isProcurementStaff() ||
        isAnalyticsStaff();

      allow write: if
        isAdmin() ||
        isFinance() ||
        isProcurementStaff();
    }

    match /goods_receipts/{id} {

      allow read, write: if
        isAdmin() ||
        isFinance() ||
        isProcurementStaff();
    }

    match /vendor_invoices/{id} {

      allow read, write: if
        isAdmin() ||
        isFinance() ||
        isProcurementStaff();
    }

    match /quotation_requests/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isProcurementStaff();
    }

    match /quotation_responses/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isProcurementStaff();
    }

    match /vendor_contracts/{id} {

      allow read, write: if
        isAdmin() ||
        isFinance() ||
        isProcurementStaff();
    }

    match /vendor_documents/{id} {

      allow read, write: if
        isAdmin() ||
        isFinance() ||
        isProcurementStaff();
    }

    // ═══════════════════════════════════════════════════════════════
    // WAREHOUSE ERP
    // ═══════════════════════════════════════════════════════════════

    match /warehouse_locations/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isInventoryManager() ||
        isProcurementStaff();
    }

    match /warehouse_bin_inventory/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isInventoryManager() ||
        isProcurementStaff();
    }

    match /warehouse_transfers/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isInventoryManager() ||
        isProcurementStaff();
    }

    match /warehouse_cycle_counts/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isInventoryManager() ||
        isProcurementStaff();
    }

    match /warehouse_damage_records/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isInventoryManager() ||
        isProcurementStaff();
    }

    // ═══════════════════════════════════════════════════════════════
    // COMPANY OS
    // ═══════════════════════════════════════════════════════════════

    match /company_notices/{id} {

      allow read: if isStaff();

      allow write: if isAdmin();
    }

    match /company_notifications/{id} {

      allow read: if isStaff();

      allow write: if isAdmin();
    }

    match /company_os_activity/{id} {

      allow read: if isStaff();

      allow create: if isStaff();

      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // COMPANY SETTINGS
    // ═══════════════════════════════════════════════════════════════

    match /company_settings/{docId} {

      allow read: if isStaff();

      allow write: if isAdmin();
    }

    match /settings_audit_logs/{id} {

      allow read: if isAdmin();

      allow create: if isStaff();

      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // BRANCH OFFICE
    // ═══════════════════════════════════════════════════════════════

    match /branch_audits/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isZoneManager() ||
        (
          isStaff() &&
          staffRole() ==
            'branch_manager'
        );
    }

    match /branch_transfers/{id} {

      allow read: if isStaff();

      allow write: if
        isAdmin() ||
        isZoneManager() ||
        (
          isStaff() &&
          staffRole() ==
            'branch_manager'
        );
    }

    // ═══════════════════════════════════════════════════════════════
    // MARKETING ERP
    // ═══════════════════════════════════════════════════════════════

    match /marketing_campaigns/{id} {
      allow read, write: if isAdmin() || isMarketingStaff();
    }

    match /marketing_coupons/{id} {
      allow read, write: if isAdmin() || isMarketingStaff();
    }

    match /loyalty_rules/{id} {
      allow read, write: if isAdmin() || isMarketingStaff();
    }

    match /marketing_automations/{id} {
      allow read, write: if isAdmin() || isMarketingStaff();
    }

    match /marketing_automation_runs/{id} {
      allow read, write: if isAdmin() || isMarketingStaff();
    }

    match /customer_referrals/{id} {
      allow read, write: if isAdmin() || isMarketingStaff();
    }

    // ═══════════════════════════════════════════════════════════════
    // AI CONTROL CENTER
    // ═══════════════════════════════════════════════════════════════

    match /ai_automations/{id} {

      allow read: if isStaff();

      allow write: if isAdmin();
    }

    match /ai_reports/{id} {

      allow read: if isStaff();

      allow write: if isAdmin();
    }

    match /ai_decision_logs/{id} {

      allow read: if isStaff();

      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // CUSTOMER SAVED ADDRESSES
    // ═══════════════════════════════════════════════════════════════

    match /addresses/{id} {

      allow read, delete: if
        isSignedIn() &&
        resource.data.userId ==
          request.auth.uid;

      allow create: if
        isSignedIn() &&
        request.resource.data.userId ==
          request.auth.uid;

      allow update: if
        isSignedIn() &&
        resource.data.userId ==
          request.auth.uid &&
        request.resource.data.userId ==
          request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════════
    // DEFAULT DENY
    // ═══════════════════════════════════════════════════════════════

    match /{document=**} {
      allow read, write: if false;
    }
  }
}